# Copy this file to .env and fill in your values

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_INPUT_TOPIC=vitals.raw
KAFKA_OUTPUT_TOPIC=vitals.clinical
KAFKA_GROUP_ID=vitals-pipeline
KAFKA_DEBUG_TOPIC=                 # optional — set to enable debug events (e.g. vitals.debug)
