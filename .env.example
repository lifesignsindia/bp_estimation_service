# Copy this file to .env and fill in your values

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# Optional: password for AUTH (leave empty if none)
#REDIS_PASSWORD=
REDIS_SSL=true

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_INPUT_TOPIC=vitals.raw
KAFKA_OUTPUT_TOPIC=vitals.clinical
KAFKA_GROUP_ID=vitals-pipeline
KAFKA_DEBUG_TOPIC=vitals.debug               # optional — set to enable debug events (e.g. vitals.debug)
