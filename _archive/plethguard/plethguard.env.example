# PlethGuard shadow service — environment reference for CI/CD.
# Copy the needed values into the deployment env / k8s manifest / secrets.
# DO NOT commit real connection strings. The service reads these with os.getenv; unset = default.

# ── Mongo sink (REQUIRED to store verdicts; if unset, the Mongo sink is OFF -> file only) ──
# Point at the SAME Mongo the pipeline uses — the INTERNAL address the prod pod reaches
# (NOT a local SSH-tunnel address). Put the real value in CI/CD secrets, not here.
PLETHGUARD_MONGO=mongodb://<prod-mongo-internal-host>:27017
PLETHGUARD_MONGO_DB=plethguard          # dedicated DB (recommended) or "local"
PLETHGUARD_MONGO_COLL=spo2_verdicts

# ── Scope: only these facilities' NISO206 are guarded (already the code default) ──
PLETHGUARD_FACILITIES=CF792698673,CF1398828720

# ── BATCH mode (recommended): reads 206 data straight from spo2_unfiltered_data, no Kafka. ──
# Run on a schedule (e.g. cron every ~5 min):
#   python plethguard/plethguard_service.py --batch --mins 60
# (uses PLETHGUARD_MONGO as both source + sink; needs pymongo installed)

# ── KAFKA (live) mode — only if the input topic actually carries 206 SpO2+pleth ──
# KAFKA_BROKERS=<brokers>
# KAFKA_INPUT_TOPIC=vitals.raw          # must be the topic that carries 206 SpO2+pleth
# PLETHGUARD_GROUP=plethguard-shadow    # keep separate from the pipeline group
#   python plethguard/plethguard_service.py --kafka

# ── Optional ──
# PLETHGUARD_OUT=plethguard/plethguard_verdicts.jsonl   # local file fallback sink
# PLETHGUARD_TOPIC=                                      # optional extra output topic (leave empty)
